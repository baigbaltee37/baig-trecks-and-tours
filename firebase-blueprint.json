{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public customer or administrator profile without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the traveler.",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Role of the user (customer or admin).",
          "enum": ["customer", "admin"],
          "maxLength": 20
        },
        "savedTourIds": {
          "type": "array",
          "description": "Bounded list of saved tour IDs (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "role", "savedTourIds", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII document for a user under /users/{userId}/private/{docId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address.",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Customer phone or WhatsApp number.",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "status", "createdAt", "updatedAt"]
    },
    "Tour": {
      "title": "Tour",
      "description": "Tour package managed by Baig Trecks & Tours.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "destination": {
          "type": "string",
          "maxLength": 80
        },
        "duration": {
          "type": "string",
          "maxLength": 60
        },
        "durationCategory": {
          "type": "string",
          "enum": ["1-3 Days", "4-6 Days", "7-10 Days", "10+ Days", "Custom"],
          "maxLength": 30
        },
        "tourType": {
          "type": "string",
          "maxLength": 60
        },
        "startingLocation": {
          "type": "string",
          "maxLength": 100
        },
        "endingLocation": {
          "type": "string",
          "maxLength": 100
        },
        "groupSize": {
          "type": "string",
          "maxLength": 80
        },
        "difficulty": {
          "type": "string",
          "maxLength": 80
        },
        "bestSeason": {
          "type": "string",
          "maxLength": 100
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 400
        },
        "overview": {
          "type": "string",
          "maxLength": 3000
        },
        "badge": {
          "type": "string",
          "maxLength": 40
        },
        "featured": {
          "type": "boolean"
        },
        "bookingStatus": {
          "type": "string",
          "enum": ["Available", "Limited Availability", "Sold Out", "Inquiry Only"],
          "maxLength": 40
        },
        "pricePerPerson": {
          "type": "number"
        },
        "couplePrice": {
          "type": "number"
        },
        "childPrice": {
          "type": "number"
        },
        "groupPriceNote": {
          "type": "string",
          "maxLength": 160
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "itinerary": {
          "type": "array",
          "description": "Bounded day-by-day itinerary items (max 20)."
        },
        "inclusions": {
          "type": "array",
          "description": "Bounded list of confirmed inclusions (max 20)."
        },
        "exclusions": {
          "type": "array",
          "description": "Bounded list of confirmed exclusions (max 20)."
        },
        "transportation": {
          "type": "string",
          "maxLength": 300
        },
        "accommodation": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "title",
        "destination",
        "duration",
        "durationCategory",
        "tourType",
        "shortDescription",
        "overview",
        "badge",
        "featured",
        "bookingStatus",
        "pricePerPerson",
        "couplePrice",
        "childPrice",
        "groupPriceNote",
        "imageUrl",
        "itinerary",
        "inclusions",
        "exclusions",
        "transportation",
        "accommodation",
        "createdAt",
        "updatedAt"
      ]
    },
    "Destination": {
      "title": "Destination",
